nextflow_process {

    name "Test Process MLST"
    script "modules/mlst.nf"
    process "MLST"

    test("Should create MLST report") {

        when {
            process {
                """
                input[0] = tuple("test_sample", file("${projectDir}/tests/test_data/21127_1#156.contigs.fasta"))
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

}
